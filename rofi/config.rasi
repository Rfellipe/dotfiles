@theme "./colors.rasi"

// Config //
configuration {
  modi:                        "drun,filebrowser,window,run";
  show-icons:                  true;
  display-drun:                "󰣇 ";
  display-run:                 " ";
  display-filebrowser:         "󰉋 ";
  display-window:              "󱂬 ";
  drun-display-format:         "{name}";
  window-format:               "{w}{t}";
}

// Main //
window {
  width: 40%;
  transparency: "real";
  fullscreen: false;
  enabled: true;
  cursor:  "default";
  background-color: @main-bg;
}
mainbox {
  enabled: true;
  orientation:vertical;
  children: [ "inputbar" , "listbox" ];
  background-color: transparent;
}

// Spacer to push mode-switcher to bottom //
spacer {
  expand: true;
  background-color: transparent;
}

// Inputs - overlaid at top with transparency //
inputbar {
  enabled: true;
  children: [ "prompt", "entry" ];
  background-color: #00000066;
  padding: 0.01em 1em;
  // border-radius: 20;
  margin: 0.6em 1em 0em 1em;
  position: north;
}
prompt {
  placeholder-color: #ffffff99;
  background-color: transparent;
  text-color:@main-fg;
  size: 20px;
  // padding: 0.01em 1em;
  margin: 0.6em 0em;
}
entry {
  enabled: true;
  placeholder: "Search...";
  placeholder-color: #ffffff99;
  background-color: transparent;
  text-color:@main-fg;
  cursor: text;
  border: 0;
  padding: 0.5em 0em;
}

// Lists //
listbox {
  spacing: 0em;
  padding: 0.7em;
  children: [ "listview" ];
  background-color: transparent;
}
listview {
  enabled: true;
  cycle: true;
  expand: false;
  lines: 10;
  columns: 1;
  cursor: "default";
  background-color: transparent;
  text-color: @main-fg;
}
dummy {
  background-color: transparent;
}

// Elements //
element {
  enabled: true;
  spacing: 0.8em;
  padding: 0.4em 0.4em 0.4em 1.5em;
  cursor: pointer;
  background-color: transparent;
  border-radius: 10;
  text-color: @main-fg;
}
element selected.normal {
  background-color: @select-bg;
  text-color: @select-fg;
}
element-icon {
  cursor: inherit;
  background-color:  transparent;
  text-color: inherit;
}
element-text {
  vertical-align: 0.5;
  horizontal-align: 0.0;
  cursor: inherit;
  background-color: transparent;
  text-color: inherit;
}

// Error message //
error-message {
  text-color: red;
  background-color: @main-bg;
  text-transform: capitalize;
  children: [ "textbox" ];
}
textbox {
  text-color: inherit;
  background-color: inherit;
  vertical-align: 0.5;
  horizontal-align: 0.5;
}

message {
  text-color: yellow;
}
